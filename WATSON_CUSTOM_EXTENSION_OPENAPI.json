{
  "openapi": "3.0.3",
  "info": {
    "title": "WealthWatch Groq Custom Extension",
    "version": "1.0.0",
    "description": "Custom extension for IBM Watson Assistant that forwards chat messages to the WealthWatch Groq endpoint."
  },
  "servers": [
    {
      "url": "https://legwarmer-pointy-vocally.ngrok-free.dev",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/chat/groq-extension": {
      "post": {
        "summary": "Process user message through Groq",
        "description": "Receives a user message from Watson Assistant and returns a Groq-generated financial advice response.",
        "operationId": "processWithGroq",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "User's chat message"
                  },
                  "userDetails": {
                    "type": "object",
                    "properties": {
                      "userId": {
                        "type": "string",
                        "description": "Optional user ID override"
                      },
                      "userName": {
                        "type": "string",
                        "description": "Optional user display name"
                      }
                    }
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Groq response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "response": {
                      "type": "string",
                      "description": "Text answer generated by Groq"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO timestamp of the response"
                    }
                  },
                  "required": ["response", "timestamp"]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing message or invalid payload"
          },
          "401": {
            "description": "Unauthorized - missing or invalid JWT token"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  }
}
